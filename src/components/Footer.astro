---
// Footer.astro - Master Site Footer
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">

      <!-- Brand Info -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/assets/images/logo-2.png" alt="Accolade Screenlady Emblem" class="footer-emblem" />
          <img src="/assets/images/logo.png" alt="Accolade Screenlady Logo" class="footer-logo-img" />
        </a>
        <p>
          Accolade Screenlady is an esteemed digital media platform and luxury print publication dedicated to honoring trailblazing women, cinematic icons, and pioneering leaders across all walks of life.
        </p>
        <p style="font-size: 0.8rem; color: var(--gold-light);">
          Producer & Concept Creator <strong>Mr. Prashant Chandrakant Sagvekar</strong>
        </p>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="footer-heading">Platform</h4>
        <ul class="footer-nav-list">
          <li><a href="/">Home</a></li>
          <li><a href="/updates">Updates & Events</a></li>
          <li><a href="/editorials">Editorial Columns</a></li>
          <li><a href="/podcast">Podcast Broadcasts</a></li>
          <li><a href="/photos">Photos & Gallery</a></li>
          <li><a href="/about-us">About Us & Vision</a></li>
          <li><a href="/social-media">Social Media Hub</a></li>
        </ul>
      </div>

      <!-- Pillars -->
      <div>
        <h4 class="footer-heading">Sections</h4>
        <ul class="footer-nav-list">
          <li><a href="/editorials">Cinema & Arts</a></li>
          <li><a href="/editorials">Corporate Leadership</a></li>
          <li><a href="/updates">Screenlady Honors</a></li>
          <li><a href="/podcast">Video Series</a></li>
          <li><a href="/about-us">Founder's Note</a></li>
        </ul>
      </div>

      <!-- Official Channels -->
      <div>
        <h4 class="footer-heading">Official Channels</h4>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem;">
          Follow our verified handles for behind-the-scenes footage, premiere alerts, and magazine release announcements.
        </p>
        <div class="social-icon-row">
          <a 
            href="https://www.instagram.com/accoladescreenlady_official?obrf=M2plNzAza252NWlu" 
            target="_blank" 
            rel="noopener" 
            class="social-icon-btn" 
            aria-label="Instagram (@accoladescreenlady_official)"
            title="Instagram (@accoladescreenlady_official)"
          >IG</a>
          <a 
            href="https://www.youtube.com/@AccoladeScreenlady" 
            target="_blank" 
            rel="noopener" 
            class="social-icon-btn" 
            aria-label="YouTube (@AccoladeScreenlady)" 
            title="YouTube (@AccoladeScreenlady)"
          >YT</a>
          <a 
            href="https://www.facebook.com/AccoladeScreenlady" 
            target="_blank" 
            rel="noopener" 
            class="social-icon-btn" 
            aria-label="Facebook (Accolade Screenlady)" 
            title="Facebook (Accolade Screenlady)"
          >FB</a>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <p>© 2026 Accolade Screenlady. All Rights Reserved.</p>
      <div class="footer-bottom-links">
        <a href="/about-us#contact">Contact Us</a>
        <span style="color: var(--text-muted); opacity: 0.4;">•</span>
        <a href="https://admin.accoladescreenlady.com" target="_blank" rel="noopener" style="color: var(--gold-light); opacity: 0.75;" title="Editorial Access">Editorial Desk</a>
      </div>
    </div>
  </div>
</footer>

