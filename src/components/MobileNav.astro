---
// MobileNav.astro - Sticky Mobile & Tablet Quick Navigation Strip (1-tap access)
interface Props {
  activeNav?: string;
}

const { activeNav = 'home' } = Astro.props;
---

<!-- Mobile Sub-Header Quick Navigation Strip (1-tap access on phones & tablets) -->
<nav class="mobile-sub-nav" aria-label="Mobile Quick Navigation">
  <a href="/" class={`mobile-sub-nav-pill ${activeNav === 'home' ? 'active' : ''}`}>Home</a>
  <a href="/updates" class={`mobile-sub-nav-pill ${activeNav === 'updates' ? 'active' : ''}`}>Updates</a>
  <a href="/editorials" class={`mobile-sub-nav-pill ${activeNav === 'editorials' ? 'active' : ''}`}>Editorials</a>
  <a href="/podcast" class={`mobile-sub-nav-pill ${activeNav === 'podcast' ? 'active' : ''}`}>Podcast</a>
  <a href="/photos" class={`mobile-sub-nav-pill ${activeNav === 'photos' ? 'active' : ''}`}>Gallery</a>
  <a href="/about-us" class={`mobile-sub-nav-pill ${activeNav === 'about-us' ? 'active' : ''}`}>About Us</a>
  <a href="/social-media" class={`mobile-sub-nav-pill ${activeNav === 'social-media' ? 'active' : ''}`}>Social Media</a>
</nav>
