---
// Header.astro - Master Site Navigation Header
interface Props {
  activeNav?: string;
}

const { activeNav = 'home' } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-logo" aria-label="Accolade Screenlady Home">
      <img src="/assets/images/logo-2.png" alt="Accolade Queen Emblem" class="brand-emblem-icon" />
      <img src="/assets/images/logo.png" alt="Accolade Screenlady Logo" class="brand-logo-img" />
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="nav-menu" aria-label="Main Navigation">
      <a 
        href="/" 
        class={`nav-link nav-home-icon ${activeNav === 'home' ? 'active' : ''}`} 
        aria-label="Home" 
        title="Home"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </a>
      <a href="/updates" class={`nav-link ${activeNav === 'updates' ? 'active' : ''}`}>Updates</a>
      <a href="/editorials" class={`nav-link ${activeNav === 'editorials' ? 'active' : ''}`}>Editorials</a>
      <a href="/podcast" class={`nav-link ${activeNav === 'podcast' ? 'active' : ''}`}>Podcast</a>
      <a href="/photos" class={`nav-link ${activeNav === 'photos' ? 'active' : ''}`}>Gallery</a>
      <a href="/about-us" class={`nav-link ${activeNav === 'about-us' ? 'active' : ''}`}>About Us</a>
    </nav>

    <!-- Header Action Controls -->
    <div class="header-actions">
      <!-- Social Media Icons -->
      <div class="header-social-links" aria-label="Official Social Channels">
        <a 
          href="https://www.instagram.com/accoladescreenlady_official?obrf=M2plNzAza252NWlu" 
          target="_blank" 
          rel="noopener" 
          class="header-social-icon instagram" 
          aria-label="Instagram (@accoladescreenlady_official)"
          title="Instagram (@accoladescreenlady_official)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a 
          href="https://www.youtube.com/@AccoladeScreenlady" 
          target="_blank" 
          rel="noopener" 
          class="header-social-icon youtube" 
          aria-label="YouTube (@AccoladeScreenlady)"
          title="YouTube (@AccoladeScreenlady)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="currentColor"></polygon>
          </svg>
        </a>
        <a 
          href="https://www.facebook.com/AccoladeScreenlady" 
          target="_blank" 
          rel="noopener" 
          class="header-social-icon facebook" 
          aria-label="Facebook (Accolade Screenlady)"
          title="Facebook (Accolade Screenlady)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
      </div>

      <button class="btn-icon search-trigger" id="searchTriggerBtn" aria-label="Search content">
        🔍
      </button>

      <button 
        class="btn btn-gold btn-sm" 
        data-modal-trigger 
        data-modal-type="magazine-preview"
        data-issue="Latest Issue (Magazine)"
        onclick="window.openMagazinePreviewModal ? window.openMagazinePreviewModal('Latest Issue (Magazine)') : (window.handleAvailableInPrintClick ? window.handleAvailableInPrintClick() : null)"
      >
        Latest Issue (Magazine)
      </button>

      <button class="hamburger" id="hamburgerBtn" aria-label="Toggle navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

