---
// TopBar.astro - Top Announcement Bar & Official Contacts
---

<aside class="top-bar">
  <div class="container top-bar-inner">
    <div class="top-bar-notice">
      <span>Accolade Screenlady • Celebrating Women of Distinction & Cultural Icons</span>
    </div>
    <div class="top-bar-links">
      <button 
        type="button" 
        class="print-highlight" 
        onclick="window.handleAvailableInPrintClick ? window.handleAvailableInPrintClick() : (window.openMagazineOrderModal ? window.openMagazineOrderModal('October 2026') : null)"
        title="Order Monthly Print Edition (₹220 Home Delivery) - Available in Print"
        aria-label="Available in Print - Order Monthly Print Edition"
      >
        <span>Available in Print</span>
      </button>
      <span class="top-bar-sep">•</span>

      <!-- Contact Us Dropdown with WhatsApp & Email -->
      <div class="top-contact-dropdown" id="contactDropdownWrap">
        <button class="top-contact-btn" id="contactDropdownTrigger" aria-expanded="false" aria-haspopup="true">
          <span>Contact Us</span>
          <svg class="dropdown-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="contact-dropdown-menu" id="contactDropdownMenu" role="menu">
          <div class="contact-dropdown-header">Official Screenlady Contact</div>

          <a href="https://wa.me/919665035503" target="_blank" rel="noopener" class="contact-dropdown-item" role="menuitem">
            <span class="contact-item-icon whatsapp-bg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </span>
            <div class="contact-item-text">
              <span class="contact-item-label">WhatsApp / Phone</span>
              <span class="contact-item-val">+91 96650 35503</span>
            </div>
          </a>

          <a href="mailto:editor@accoladescreenlady.com" class="contact-dropdown-item" role="menuitem">
            <span class="contact-item-icon email-bg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </span>
            <div class="contact-item-text">
              <span class="contact-item-label">Editor Email</span>
              <span class="contact-item-val">editor@accoladescreenlady.com</span>
            </div>
          </a>

          <a href="mailto:AccoladeScreenlady@gmail.com" class="contact-dropdown-item" role="menuitem">
            <span class="contact-item-icon email-bg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </span>
            <div class="contact-item-text">
              <span class="contact-item-label">Editorial Desk</span>
              <span class="contact-item-val">AccoladeScreenlady@gmail.com</span>
            </div>
          </a>

          <div class="contact-dropdown-footer">
            <a href="/about-us#contact">Open Full Contact Desk →</a>
          </div>
        </div>
      </div>

      <span class="top-bar-sep">•</span>

      <!-- Google Real Authentication Wrapper -->
      <div class="google-auth-wrapper" id="googleAuthWrapper">
        <button class="btn-google-auth" id="googleAuthBtn" aria-label="Sign in with Google">
          <svg class="google-icon" width="14" height="14" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span>Sign In / Sign Up</span>
        </button>
        <div class="user-profile-badge" id="userProfileBadge" style="display: none;">
          <img class="user-avatar" id="userAvatar" src="" alt="Google Profile">
          <span class="user-name" id="userName">User</span>
          <button class="btn-signout" id="googleSignoutBtn" title="Sign Out">✕</button>
        </div>
      </div>
    </div>
  </div>
</aside>

