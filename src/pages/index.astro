---
// index.astro - Homepage
import BaseLayout from '../layouts/BaseLayout.astro';

const extraScripts = [
  "/assets/js/home-slider.js",
  "/assets/js/editorial-homepage.js",
  "/assets/js/updates.js",
  "/assets/js/home-news-photos.js"
];
---

<BaseLayout 
  title="Home"
  description="Accolade Screenlady - Premium women-centric magazine and digital media platform."
  activeNav="home"
  extraScripts={extraScripts}
>
  <!-- ==============================================
       HOME SECTION: MAGAZINE COVER SLIDESHOW & TIMELINE
  ============================================== -->
  <main class="main-content" id="homeSection" style="padding: 1.5rem 0 3.5rem;">
    <div class="container">

      <!-- ==============================================
           HOMEPAGE HERO SPLIT SECTION: 
           LEFT: 4 Latest News in Horizontal Format (with photos & running highlights)
           RIGHT: Curated Photo Gallery Slideshow
           ============================================== -->
      <section class="home-hero-split-section" id="homeHeroSplitSection" aria-label="Latest News & Event Photo Showcase">
        <div class="home-split-grid">
          <!-- LEFT COLUMN: 4 Latest News Running in Horizontal Format -->
          <div class="home-split-news-col">
            <div class="home-split-col-header">
              <div class="home-split-header-left">
                <span class="home-split-kicker-pill">
                  <span class="live-pulse-dot"></span> ✦ Real-Time Live News
                </span>
                <h2 class="home-split-title">Screenlady Updates</h2>
              </div>
              <a href="/updates" class="home-split-view-all-btn" title="View all updates and news">
                <span>All Screenlady Updates</span>
                <span class="btn-arrow">→</span>
              </a>
            </div>
            <div class="home-news-horizontal-list" id="homeLatestNewsList">
              <!-- Dynamically populated by assets/js/home-news-photos.js -->
            </div>
            <!-- Slider / Pagination for Previous News -->
            <div class="home-news-pagination" id="homeNewsPagination">
              <!-- Dynamically populated by assets/js/home-news-photos.js -->
            </div>
          </div>

          <!-- RIGHT COLUMN: Photo Showcase Slideshow -->
          <div class="home-split-photos-col">
            <div class="home-split-col-header">
              <div class="home-split-header-left">
                <span class="home-split-kicker-pill">✦ Event Photo Archives</span>
                <h2 class="home-split-title">Photo Gallery Showcase</h2>
              </div>
              <a href="/photos" class="home-split-view-all-btn" title="View all photo galleries">
                <span>All Photos</span>
                <span class="btn-arrow">→</span>
              </a>
            </div>
            <div class="home-photo-slideshow-wrap" id="homePhotoSlideshowWrap">
              <div class="home-photo-slides-stage" id="homePhotoSlidesStage">
                <!-- Dynamically populated by assets/js/home-news-photos.js -->
              </div>
              <button type="button" class="home-photo-arrow prev" id="homePhotoPrevBtn" aria-label="Previous Photograph">‹</button>
              <button type="button" class="home-photo-arrow next" id="homePhotoNextBtn" aria-label="Next Photograph">›</button>
              <div class="home-photo-dots" id="homePhotoDots"></div>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- ==============================================
       SECTION 1: HERO SECTION (Merged with Magazine Editions Slideshow)
  ============================================== -->
  <section class="editorial-hero-section" id="heroSection">
    <div class="container">
      <div class="editorial-hero-grid">

        <div class="editorial-hero-content">
          <div class="editorial-kicker">
            <span>✦ A Marathi Magazine Celebrating Women</span>
          </div>
          <h1 class="editorial-hero-headline">
            A Marathi Magazine Exploring the Diverse World of Women
          </h1>
          <p class="editorial-hero-desc">
            Today's woman is no longer confined to managing household responsibilities. She is making her mark in entertainment, politics, industry, business, education, medicine, technology, the stock market, real estate and numerous other fields. With her intelligence, hard work and determination, she is reaching new heights of success. Recognising the journeys of such accomplished women and bringing their achievements into the spotlight is the vision behind <strong>Accolade Screenlady</strong>, a unique magazine dedicated to celebrating women.
          </p>
          <div class="editorial-hero-actions">
            <a href="/about-us" class="btn-editorial-gold" id="heroDiscoverStoryBtn">
              <span>Discover Our Story</span>
              <span>→</span>
            </a>
            <button 
              type="button" 
              class="btn-editorial-outline" 
              id="heroExploreMagazineBtn" 
              onclick="window.handleAvailableInPrintClick ? window.handleAvailableInPrintClick() : (window.openMagazineOrderModal ? window.openMagazineOrderModal('October 2026') : null)"
            >
              <span>Order Collector's Edition</span>
            </button>
          </div>
        </div>

        <div class="editorial-hero-visual">
          <div class="pure-cover-slideshow-wrap">
            <div class="pure-slideshow-theater" id="slideshowTheater">

              <!-- Prev Button -->
              <button type="button" class="pure-nav-arrow prev" id="slidePrevBtn" aria-label="Previous Cover" title="Previous Cover">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>

              <!-- Slides Stage (Dynamically populated from Cloudflare D1 database) -->
              <div class="pure-slides-stage" id="slidesStage">
                <!-- Populated dynamically from database by assets/js/home-slider.js -->
              </div>

              <!-- Next Button -->
              <button type="button" class="pure-nav-arrow next" id="slideNextBtn" aria-label="Next Cover" title="Next Cover">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>

            </div>

            <!-- Timeline of Covers (Dynamically populated from Cloudflare D1 database) -->
            <nav class="pure-timeline" aria-label="Edition Timeline">
              <div class="pure-timeline-track" id="timelineTrack">
                <!-- Populated dynamically from database by assets/js/home-slider.js -->
              </div>
            </nav>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 2: FILMY ADDA (Left: 4 Film Photos | Right: Content)
  ============================================== -->
  <section class="curated-feature-section filmy-adda-section" id="filmyAddaSection">
    <div class="container">
      <div class="curated-split-grid">

        <!-- Left Column: 4 Film Photos in Interactive Grid (Populated dynamically from database) -->
        <div class="curated-photos-grid" id="filmyAddaPhotosGrid">
          <!-- Dynamically populated from Cloudflare D1 database by assets/js/home-news-photos.js -->
        </div>

        <!-- Right Column: Filmy Adda Information Text -->
        <div class="curated-content-box">
          <div class="curated-box-inner-top">
            <h2 class="curated-title-top">FILMY ADDA</h2>
            <div class="curated-subtitle">The World of Glamour, Cinema & Celebrities</div>

            <p class="curated-body-text">
              Lights, Camera, Action! Welcome to <strong>Filmy Adda</strong>, your ultimate destination for everything happening in the world of cinema and entertainment. From the glamour of Bollywood to the vibrant world of Marathi cinema, we bring you closer to your favourite stars, their personal journeys, upcoming movie releases, box-office milestones, and behind-the-scenes stories.
            </p>
            <p class="curated-body-text">
              Discover exclusive interviews with renowned actors, actresses, filmmakers, singers, and emerging talents who are making their mark. Whether it is the magic of the silver screen, television drama, or the growing influence of digital OTT entertainment, Filmy Adda keeps you connected with every major development.
            </p>
            <p class="curated-body-text">
              From prestigious Marathi film festivals and National Film Awards to red carpet premieres and exclusive set visits, our cinema bureau delivers uncompromised journalistic depth, authentic photo spreads, and high-impact discussions with the storytellers shaping our screen culture.
            </p>
            <p class="curated-body-text">
              Celebrating the multifaceted power of visual storytelling, we chronicle how women screenwriters, producers, technicians, and actors are transforming modern entertainment, blending commercial appeal with cultural integrity.
            </p>

            <div class="filmy-pillars-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.65rem; margin: 0.95rem 0;">
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">🎬</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Cinema & Studio Shoots</span>
              </div>
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">🌟</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Celebrity Spotlight</span>
              </div>
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">🍿</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Box Office & Trade</span>
              </div>
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">🎥</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Behind the Screen</span>
              </div>
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">🏆</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Red Carpet & Awards</span>
              </div>
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">🎧</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Music & Playback Arts</span>
              </div>
            </div>

            <div class="curated-quote-pill">
              “Because every star has a story, and every story deserves the spotlight — only on Accolade Screenlady!”
            </div>

            <div class="curated-tagline" style="margin-top: 0.85rem; margin-bottom: 0;">
              Filmy Adda – Your Daily Dose of Cinema, Celebrities & Entertainment
            </div>
          </div>

          <div class="curated-box-inner-bottom" style="display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.25rem;">
            <a href="/updates" class="btn-editorial-gold" style="font-size: 0.84rem; padding: 0.65rem 1.35rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>Explore All Cinema Updates</span>
              <span>→</span>
            </a>
            <a href="/photos" class="btn-editorial-outline" style="font-size: 0.84rem; padding: 0.65rem 1.35rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>View Film Gallery</span>
              <span>→</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 3: BIZZ WORLD (Left: Content | Right: 4 Business Photos)
  ============================================== -->
  <section class="curated-feature-section bizz-world-section" id="bizzWorldSection">
    <div class="container">
      <div class="curated-split-grid">

        <!-- Left Column: Business & Enterprise Content -->
        <div class="curated-content-box">
          <div class="curated-box-inner-top">
            <h2 class="curated-title-top">BIZZ WORLD</h2>
            <div class="curated-subtitle">Corporate Pioneers, Startups & Women Entrepreneurs</div>

            <p class="curated-body-text">
              Welcome to <strong>Bizz World</strong>, Accolade Screenlady’s premier corporate chronicle spotlighting visionary industrial leaders, executive directors, and pioneering women entrepreneurs who are driving commerce, innovation, and sustainable leadership across Maharashtra and nationwide.
            </p>
            <p class="curated-body-text">
              From dynamic grassroots enterprises and small-business founders to established corporate conglomerates, we deliver authentic reports on market expansions, funding triumphs, administrative breakthroughs, and brand journeys. We celebrate women breaking glass ceilings in finance, technology, manufacturing, and retail.
            </p>

            <div class="bizz-pillars-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.65rem; margin: 0.95rem 0;">
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">📈</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Executive Governance</span>
              </div>
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">🚀</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Women-Led Startups</span>
              </div>
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">💎</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Brand & SME Spotlights</span>
              </div>
              <div style="background: rgba(255,255,255,0.035); border: 1px solid rgba(212,175,55,0.25); border-radius: 8px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 1.05rem;">🤝</span>
                <span style="font-size: 0.8rem; color: #FFFFFF; font-weight: 600;">Conclaves & Summits</span>
              </div>
            </div>

            <div class="curated-quote-pill" style="margin: 0.85rem 0;">
              “From boardroom strategy to grassroots entrepreneurship — celebrating women who build industries, create employment, and lead the future.”
            </div>

            <div class="curated-tagline" style="margin-top: 0.75rem; margin-bottom: 0;">
              Bizz World – Where Leadership Meets Ambition & Enterprise
            </div>
          </div>

          <div class="curated-box-inner-bottom" style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem;">
            <a href="https://wa.me/919665035503?text=Hello%20Accolade%20Screenlady%20Team%2C%20I%20am%20interested%20in%20Business%20Features%20and%20Brand%20Promotions." target="_blank" rel="noopener" class="btn-editorial-gold" style="font-size: 0.82rem; padding: 0.65rem 1.2rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>💬 Advertise via WhatsApp</span>
              <span>→</span>
            </a>
            <a href="mailto:editor@accoladescreenlady.com?cc=AccoladeScreenlady@gmail.com&subject=Bizz%20World%20Brand%20Feature%20Inquiry" class="btn-editorial-outline" style="font-size: 0.82rem; padding: 0.65rem 1.2rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>✉️ Brand Desk</span>
              <span>→</span>
            </a>
            <a href="/updates" class="btn-editorial-outline" style="font-size: 0.82rem; padding: 0.65rem 1.2rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>Read in Updates</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Right Column: 4 Business & Enterprise Photos (Populated dynamically from database) -->
        <div class="curated-photos-grid" id="bizzWorldPhotosGrid">
          <!-- Dynamically populated from Cloudflare D1 database by assets/js/home-news-photos.js -->
        </div>

      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 4: WOMEN OF INSPIRATION (Struggle to Success)
  ============================================== -->
  <section class="curated-showcase-section women-inspiration-section" id="womenInspirationSection">
    <div class="container">

      <div class="editorial-header-center">
        <span class="editorial-kicker">✦ Triumphs Over Adversity</span>
        <h2 class="editorial-section-title-dark">Women of Inspiration</h2>
        <p class="editorial-section-sub-dark" style="max-width: 820px; margin: 0 auto 1.75rem;">
          Behind every successful woman lies an inspiring story of courage, struggle, and perseverance. Accolade Screenlady honors trailblazing women who overcame challenging circumstances to establish their own identities, setting new benchmarks in social service, business, science, technology, medicine, and governance. Click any story to read in full.
        </p>
      </div>

      <!-- 4 Showcase Cards Grid (Populated dynamically from database) -->
      <div class="curated-showcase-grid" id="womenInspirationGrid">
        <!-- Dynamically populated from Cloudflare D1 database by assets/js/home-news-photos.js -->
      </div>

    </div>
  </section>

  <!-- ==============================================
       SECTION 5: FASHION AND LIFESTYLE (Couture & Living)
  ============================================== -->
  <section class="curated-showcase-section fashion-lifestyle-section" id="fashionLifestyleSection">
    <div class="container">

      <div class="editorial-header-center">
        <span class="editorial-kicker">✦ Haute Aesthetics & Living</span>
        <h2 class="editorial-section-title-dark">Fashion and Lifestyle</h2>
        <p class="editorial-section-sub-dark" style="max-width: 820px; margin: 0 auto 1.75rem;">
          When exploring the world of women, fashion, beauty, jewellery, and contemporary living hold special importance. Accolade Screenlady covers haute couture, traditional elegance, wellness, and thought-provoking lifestyle perspectives. Click any feature to read in full.
        </p>
      </div>

      <!-- 4 Showcase Cards Grid (Populated dynamically from database) -->
      <div class="curated-showcase-grid" id="fashionLifestyleGrid">
        <!-- Dynamically populated from Cloudflare D1 database by assets/js/home-news-photos.js -->
      </div>

    </div>
  </section>

  <!-- ==============================================
       SECTION 8: CLOSING PHILOSOPHY BANNER
  ============================================== -->
  <section class="editorial-philosophy-banner" id="philosophyBanner">
    <div class="container philosophy-container">

      <img src="/assets/images/logo-2.png" alt="Accolade Queen Crest" class="philosophy-crest" />

      <div style="font-family: var(--font-editorial-body); font-size: 0.85rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-light-accent); margin-bottom: 1rem;">
        ✦ ACCOLADE SCREENLADY – A MIRROR OF THE WORLD OF WOMEN! ✦
      </div>

      <h2 class="philosophy-tagline-primary" style="font-size: clamp(2rem, 3.8vw, 3.2rem); margin-bottom: 1.5rem;">
        Celebrating Women's Success, Inspiring the Next Generation!
      </h2>

      <div style="max-width: 840px; margin: 0 auto 2.5rem; color: #D8D3C8; font-family: var(--font-editorial-body); font-size: 1.02rem; line-height: 1.8;">
        <p style="margin-bottom: 1rem;">
          Today, women have more opportunities than ever to demonstrate their abilities and establish themselves in different fields. However, platforms that recognise their achievements and bring their experiences and stories to society are equally important. Accolade Screenlady is committed to contributing to this vision.
        </p>
        <p>
          From celebrated actresses to successful entrepreneurs in rural communities, from political leaders to corporate professionals, and from established personalities to women who have built their own identities through determination and hard work, the magazine aims to bring the stories of women from every walk of life into the spotlight.
        </p>
      </div>

      <div style="padding: 1.5rem 2rem; border-top: 1px solid rgba(212, 175, 55, 0.3); border-bottom: 1px solid rgba(212, 175, 55, 0.3); margin-bottom: 2.5rem; background: rgba(212, 175, 55, 0.05); border-radius: 8px;">
        <div style="font-family: var(--font-editorial-heading); font-size: clamp(1.4rem, 2.5vw, 2.2rem); font-weight: 800; color: #FFFFFF; margin-bottom: 0.65rem;">
          “Her Beauty, Her Achievements, Her Story of Struggle!”
        </div>
        <div style="font-family: var(--font-editorial-heading); font-size: clamp(1.1rem, 1.8vw, 1.5rem); font-style: italic; color: var(--gold-light-accent);">
          “Because every woman has a story to tell... and every story deserves to reach the world!”
        </div>
      </div>

      <div class="philosophy-actions">
        <button 
          type="button" 
          class="btn-editorial-gold" 
          onclick="window.handleAvailableInPrintClick ? window.handleAvailableInPrintClick() : (window.openMagazineOrderModal ? window.openMagazineOrderModal('October 2026') : null)"
        >
          <span>Order Collector's Print Edition</span>
          <span>→</span>
        </button>
        <a href="/about-us#contact" class="btn-editorial-outline">
          <span>Connect With Our Editorial Desk</span>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
