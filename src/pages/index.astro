---
// index.astro - Homepage
import BaseLayout from '../layouts/BaseLayout.astro';

const extraScripts = [
  "/assets/js/home-slider.js",
  "/assets/js/editorial-homepage.js",
  "/assets/js/home-news-photos.js"
];
---

<BaseLayout 
  title="Home"
  description="Accolade Screenlady - Premium women-centric magazine and digital media platform."
  activeNav="home"
  extraScripts={extraScripts}
>
  <!-- ==============================================
       HOME SECTION: MAGAZINE COVER SLIDESHOW & TIMELINE
  ============================================== -->
  <main class="main-content" id="homeSection" style="padding: 1.5rem 0 3.5rem;">
    <div class="container">

      <!-- ==============================================
           HOMEPAGE HERO SPLIT SECTION: 
           LEFT: 4 Latest News in Horizontal Format
           RIGHT: Curated Photo Gallery Slideshow
           ============================================== -->
      <section class="home-hero-split-section" id="homeHeroSplitSection" aria-label="Latest News & Event Photo Showcase">
        <div class="home-split-grid">
          <!-- LEFT COLUMN: Latest News Horizontal List -->
          <div class="home-split-news-col">
            <div class="home-split-col-header">
              <div class="home-split-header-left">
                <span class="home-split-kicker-pill">
                  <span class="live-pulse-dot"></span> Real-Time News
                </span>
                <h2 class="home-split-title">Screenlady Updates</h2>
              </div>
              <a href="/updates" class="home-split-view-all-btn" title="View all updates and news">
                <span>All Updates</span>
                <span class="btn-arrow">→</span>
              </a>
            </div>
            <div class="home-news-horizontal-list" id="homeLatestNewsList">
              <!-- Dynamically populated by assets/js/home-news-photos.js -->
            </div>
            <!-- Slider / Pagination for Previous News -->
            <div class="home-news-pagination" id="homeNewsPagination">
              <!-- Dynamically populated by assets/js/home-news-photos.js -->
            </div>
          </div>

          <!-- RIGHT COLUMN: Executive Brand Spotlight (NO 'ads' word) -->
          <div class="home-split-photos-col">
            <div class="home-split-col-header">
              <div class="home-split-header-left">
                <span class="home-split-kicker-pill">Corporate & Enterprise</span>
                <h2 class="home-split-title">Brand Spotlight</h2>
              </div>
              <div class="home-split-view-all-btn" style="cursor: default; pointer-events: none;">
                <span>Featured Partners</span>
                <span class="btn-arrow">✦</span>
              </div>
            </div>
            <div class="home-photo-slideshow-wrap" id="homePhotoSlideshowWrap">
              <div class="home-photo-slides-stage" id="homePhotoSlidesStage">
                <!-- Dynamically populated by assets/js/home-news-photos.js from business_ads table -->
              </div>
              <button type="button" class="home-photo-arrow prev" id="homePhotoPrevBtn" aria-label="Previous Spotlight">‹</button>
              <button type="button" class="home-photo-arrow next" id="homePhotoNextBtn" aria-label="Next Spotlight">›</button>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- ==============================================
       SECTION 1: HERO SECTION (Magazine Editions Slideshow)
  ============================================== -->
  <section class="editorial-hero-section" id="heroSection">
    <div class="container">
      <div class="editorial-hero-grid">

        <div class="editorial-hero-content">
          <div class="editorial-kicker">
            <span>A Marathi Publication Celebrating Women</span>
          </div>
          <h1 class="editorial-hero-headline">
            Exploring the Diverse World of Women
          </h1>
          <p class="editorial-hero-desc">
            Spotlighting accomplished women across cinema, corporate leadership, governance, entrepreneurship, and cultural arts. Bringing remarkable journeys and achievements into focus.
          </p>
          <div class="editorial-hero-actions">
            <a href="/about-us" class="btn-editorial-gold" id="heroDiscoverStoryBtn">
              <span>Discover Our Story</span>
              <span>→</span>
            </a>
            <button 
              type="button" 
              class="btn-editorial-outline" 
              id="heroExploreMagazineBtn" 
              onclick="window.handleAvailableInPrintClick ? window.handleAvailableInPrintClick() : (window.openMagazineOrderModal ? window.openMagazineOrderModal() : null)"
            >
              <span>Order Print Edition</span>
            </button>
          </div>
        </div>

        <div class="editorial-hero-visual">
          <div class="pure-cover-slideshow-wrap">
            <div class="pure-slideshow-theater" id="slideshowTheater">

              <!-- Prev Button -->
              <button type="button" class="pure-nav-arrow prev" id="slidePrevBtn" aria-label="Previous Cover" title="Previous Cover">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>

              <!-- Slides Stage (Dynamically populated from Cloudflare D1 database by assets/js/home-slider.js) -->
              <div class="pure-slides-stage" id="slidesStage">
                <!-- Dynamically populated from backend database -->
              </div>

              <!-- Next Button -->
              <button type="button" class="pure-nav-arrow next" id="slideNextBtn" aria-label="Next Cover" title="Next Cover">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>

            </div>

            <!-- Timeline of Covers (Dynamically populated from Cloudflare D1 database by assets/js/home-slider.js) -->
            <nav class="pure-timeline" aria-label="Edition Timeline">
              <div class="pure-timeline-track" id="timelineTrack">
                <!-- Dynamically populated from backend database -->
              </div>
            </nav>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 2: FILMY ADDA (Left: 4 Film Photos | Right: Content)
  ============================================== -->
  <section class="curated-feature-section filmy-adda-section" id="filmyAddaSection">
    <div class="container">
      <div class="curated-split-grid">

        <!-- Left Column: 4 Film Photos in Interactive Grid -->
        <div class="curated-photos-grid" id="filmyAddaPhotosGrid">
          <!-- Dynamically populated from Cloudflare D1 database by assets/js/home-news-photos.js -->
        </div>

        <!-- Right Column: Filmy Adda Content -->
        <div class="curated-content-box">
          <div class="curated-box-inner-top">
            <h2 class="curated-title-top">FILMY ADDA</h2>
            <div class="curated-subtitle">Cinema, Celebrities & Visual Storytelling</div>

            <p class="curated-body-text">
              From Marathi cinema to Bollywood, Filmy Adda chronicles the women screenwriters, directors, actors, and technicians shaping screen culture with critical depth, authentic photo spreads, and industry insights.
            </p>

            <div class="curated-pillars-list" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0;">
              <span class="curated-pillar-tag">Studio & Cinema</span>
              <span class="curated-pillar-tag">Celebrity Spotlight</span>
              <span class="curated-pillar-tag">Box Office Trade</span>
              <span class="curated-pillar-tag">Playback Arts</span>
            </div>

            <div class="curated-quote-pill">
              “Every star has a story, and every story deserves the spotlight.”
            </div>
          </div>

          <div class="curated-box-inner-bottom" style="display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.5rem;">
            <a href="/updates" class="btn-editorial-gold" style="font-size: 0.84rem; padding: 0.65rem 1.35rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>Cinema Updates</span>
              <span>→</span>
            </a>
            <a href="/photos" class="btn-editorial-outline" style="font-size: 0.84rem; padding: 0.65rem 1.35rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>Photo Gallery</span>
              <span>→</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 3: BIZZ WORLD (Left: Content | Right: 4 Business Photos)
  ============================================== -->
  <section class="curated-feature-section bizz-world-section" id="bizzWorldSection">
    <div class="container">
      <div class="curated-split-grid">

        <!-- Left Column: Business & Enterprise Content -->
        <div class="curated-content-box">
          <div class="curated-box-inner-top">
            <h2 class="curated-title-top">BIZZ WORLD</h2>
            <div class="curated-subtitle">Enterprise, Governance & Women Pioneers</div>

            <p class="curated-body-text">
              Accolade Screenlady’s corporate chronicle spotlighting visionary industrial leaders, executive directors, and women entrepreneurs driving commerce, innovation, and sustainable leadership.
            </p>

            <div class="curated-pillars-list" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0;">
              <span class="curated-pillar-tag">Corporate Governance</span>
              <span class="curated-pillar-tag">Women-Led Ventures</span>
              <span class="curated-pillar-tag">Brand Features</span>
              <span class="curated-pillar-tag">Leadership Summits</span>
            </div>

            <div class="curated-quote-pill">
              “Celebrating women who build industries, create opportunities, and lead the future.”
            </div>
          </div>

          <div class="curated-box-inner-bottom" style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem;">
            <a href="https://wa.me/919665035503?text=Hello%20Accolade%20Screenlady%20Team%2C%20I%20am%20interested%20in%20Business%20Features." target="_blank" rel="noopener" class="btn-editorial-gold" style="font-size: 0.82rem; padding: 0.65rem 1.2rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>Brand Inquiries</span>
              <span>→</span>
            </a>
            <a href="/updates" class="btn-editorial-outline" style="font-size: 0.82rem; padding: 0.65rem 1.2rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
              <span>Read in Updates</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Right Column: 4 Business & Enterprise Photos -->
        <div class="curated-photos-grid" id="bizzWorldPhotosGrid">
          <!-- Dynamically populated from Cloudflare D1 database by assets/js/home-news-photos.js -->
        </div>

      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 4: WOMEN OF INSPIRATION
  ============================================== -->
  <section class="curated-showcase-section women-inspiration-section" id="womenInspirationSection">
    <div class="container">

      <div class="editorial-header-center">
        <span class="editorial-kicker">Triumphs Over Adversity</span>
        <h2 class="editorial-section-title-dark">Women of Inspiration</h2>
        <p class="editorial-section-sub-dark" style="max-width: 680px; margin: 0 auto 1.75rem;">
          Honoring women who surmounted arduous circumstances to forge distinct paths across social reform, medicine, science, and governance.
        </p>
      </div>

      <!-- 4 Showcase Cards Grid -->
      <div class="curated-showcase-grid" id="womenInspirationGrid">
        <!-- Dynamically populated from Cloudflare D1 database by assets/js/home-news-photos.js -->
      </div>

    </div>
  </section>

  <!-- ==============================================
       SECTION 5: FASHION AND LIFESTYLE
  ============================================== -->
  <section class="curated-showcase-section fashion-lifestyle-section" id="fashionLifestyleSection">
    <div class="container">

      <div class="editorial-header-center">
        <span class="editorial-kicker">Aesthetics & Contemporary Living</span>
        <h2 class="editorial-section-title-dark">Fashion and Lifestyle</h2>
        <p class="editorial-section-sub-dark" style="max-width: 680px; margin: 0 auto 1.75rem;">
          Exploring haute couture, traditional craftsmanship, wellness, and personal growth for modern women balancing ambition and serenity.
        </p>
      </div>

      <!-- 4 Showcase Cards Grid -->
      <div class="curated-showcase-grid" id="fashionLifestyleGrid">
        <!-- Dynamically populated from Cloudflare D1 database by assets/js/home-news-photos.js -->
      </div>

    </div>
  </section>

  <!-- ==============================================
       SECTION 6: CLOSING PHILOSOPHY BANNER
  ============================================== -->
  <section class="editorial-philosophy-banner" id="philosophyBanner">
    <div class="container philosophy-container">

      <img src="/assets/images/logo-2.png" alt="Accolade Queen Crest" class="philosophy-crest" />

      <div style="font-family: var(--font-editorial-body); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-light-accent); margin-bottom: 1rem;">
        ACCOLADE SCREENLADY — A MIRROR OF THE WORLD OF WOMEN
      </div>

      <h2 class="philosophy-tagline-primary" style="font-size: clamp(1.8rem, 3.2vw, 2.8rem); margin-bottom: 1.25rem;">
        Celebrating Women's Achievements, Inspiring the Future
      </h2>

      <p style="max-width: 640px; margin: 0 auto 2rem; color: #D8D3C8; font-family: var(--font-editorial-body); font-size: 0.98rem; line-height: 1.7;">
        From cinema luminaries to grassroots entrepreneurs, from corporate boardrooms to cultural pioneers — dedicated to bringing authentic stories of determination and excellence into focus.
      </p>

      <div style="padding: 1.25rem 1.75rem; border-top: 1px solid rgba(212, 175, 55, 0.25); border-bottom: 1px solid rgba(212, 175, 55, 0.25); margin-bottom: 2rem; background: rgba(212, 175, 55, 0.03); border-radius: 6px;">
        <div style="font-family: var(--font-editorial-heading); font-size: clamp(1.2rem, 2vw, 1.6rem); font-weight: 700; color: #FFFFFF; margin-bottom: 0.4rem;">
          “Her Beauty, Her Achievements, Her Story.”
        </div>
        <div style="font-family: var(--font-editorial-heading); font-size: clamp(0.95rem, 1.4vw, 1.15rem); font-style: italic; color: var(--gold-light-accent);">
          Every woman has a journey worth telling.
        </div>
      </div>

      <div class="philosophy-actions">
        <button 
          type="button" 
          class="btn-editorial-gold" 
          onclick="window.handleAvailableInPrintClick ? window.handleAvailableInPrintClick() : (window.openMagazineOrderModal ? window.openMagazineOrderModal() : null)"
        >
          <span>Order Print Edition</span>
          <span>→</span>
        </button>
        <a href="/about-us#contact" class="btn-editorial-outline">
          <span>Contact Editorial Desk</span>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
