---
// editorials.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const extraScripts = ["/assets/js/editorials.js"];
---

<BaseLayout
  title="Editorials"
  description="Read insightful columns, deep essays, and perspectives on cinema, culture, and women in leadership."
  activeNav="editorials"
  extraScripts={extraScripts}
>
<!-- Main Content Layout Section: Editorial Columns & Essays Feed (Latest First) -->
  <main class="main-content" style="min-height: 70vh; padding: 3rem 0 5rem;">
    <div class="container">

      <!-- Editorials Page Header -->
      <section class="updates-page-header">
        <div class="updates-header-badge">
          <span>Screenlady Columns & Essays</span>
        </div>
        <h1 class="updates-page-title">
          Editorials & Cultural Inquiries
        </h1>
        <p class="updates-page-desc">
          Long-form perspectives and philosophical discourses authored by cultural scholars and the Accolade Screenlady Editorial Council.
        </p>

        <!-- Editorials Control Toolbar: Category Filter & Count -->
        <div class="updates-toolbar">
          <div class="updates-filter-group" role="tablist" aria-label="Filter Editorials">
            <button class="editorials-filter-btn active" data-filter="all">All Editorials</button>
            <button class="editorials-filter-btn" data-filter="Heritage">Heritage & Craftsmanship</button>
            <button class="editorials-filter-btn" data-filter="Commentary">Social Commentary</button>
          </div>

          <div class="updates-actions-group">
            <span id="editorialsTotalCount" style="font-size: 0.78rem; color: var(--gold-light); font-weight: 600; letter-spacing: 0.04em;"></span>
          </div>
        </div>

        <!-- Quick Open Bar for Immediate Full Screen Reading -->
        <div class="editorial-quick-jump-bar">
          <span class="jump-bar-label">Read Full Screen:</span>
        </div>
      </section>

      <!-- Chronological Editorials Feed: Magazine Multi-Column Editorial Layout -->
      <div class="editorials-feed" id="editorialsFeedContainer">
        <!-- Rendered dynamically by editorials.js (Latest always displays first) -->
      </div>

    </div>
  </main>

  <!-- Dedicated Full-Screen Article Reader Modal -->
  <div class="editorial-fullscreen-reader" id="editorialFullScreenReader" role="dialog" aria-modal="true" style="display: none;">
    <header class="reader-top-bar">
      <div class="reader-top-inner">
        <div class="reader-brand">
          <img src="/assets/images/logo-2.png" alt="Accolade Screenlady Emblem" class="reader-emblem" />
          <span class="reader-brand-label">Screenlady Reader Mode</span>
        </div>

        <div class="reader-progress-track">
          <div class="reader-progress-fill" id="readerProgressFill"></div>
        </div>

        <div class="reader-actions">
          <a href="#" id="readerWhatsappBtn" target="_blank" rel="noopener" class="reader-btn" title="Share on WhatsApp">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>WhatsApp</span>
          </a>
          <button type="button" class="reader-btn" id="readerCopyBtn" title="Copy Article Link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span>Copy Link</span>
          </button>
          <button type="button" class="reader-btn close-btn" onclick="closeFullScreenReader()" title="Close Reader (Esc)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span>Close</span>
          </button>
        </div>
      </div>
    </header>

    <div class="reader-body-container" id="readerBodyContainer">
      <!-- Injected dynamically by editorials.js -->
    </div>
  </div>
</BaseLayout>
