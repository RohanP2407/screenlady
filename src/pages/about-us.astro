---
// about-us.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const extraScripts = ["/assets/js/editorial-homepage.js"];
---

<BaseLayout
  title="About Us"
  description="Learn about Accolade Screenlady, our vision, board members, and editorial team."
  activeNav="about-us"
  extraScripts={extraScripts}
>
<!-- Main Content Layout Section -->
  <main class="about-page-main">

    <!-- Hero Header Banner -->
    <section class="about-page-hero">
      <div class="container">
        <span class="about-page-kicker">✦ The Mirror of the World of Women</span>
        <h1 class="about-page-title">About Accolade Screenlady</h1>
        <p class="about-page-sub">
          A premier Marathi magazine and digital media platform exploring the diverse dimensions of women's
          personalities, struggles, achievements, and triumphs — from entertainment to entrepreneurship, from glamour to
          great milestones.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="#vision" class="btn-editorial-gold"><span>Our Story & Vision</span><span>↓</span></a>
          <a href="#team" class="btn-editorial-outline"><span>Meet Our Leadership Team</span><span>↓</span></a>
        </div>
      </div>
    </section>

    <!-- Section 1: Story & Vision (Light Warm Ivory) -->
    <section class="editorial-about-section" id="vision">
      <div class="container">
        <div class="editorial-about-grid">

          <div class="about-photo-wrapper">
            <div class="about-magazine-frame" data-lightbox-src="/assets/images/magazine-photos/random2.jpg"
              data-lightbox-title="Accolade Screenlady - Editorial Spread"
              data-lightbox-theme="About Accolade Screenlady">
              <img src="/assets/images/magazine-photos/random2.jpg" alt="Accolade Screenlady Magazine Spread"
                class="about-magazine-img">
            </div>
          </div>

          <div class="about-editorial-content">
            <span class="editorial-kicker-light">✦ Women-Centric Marathi Publication</span>
            <h2 class="editorial-section-title-light">
              About Accolade Screenlady
            </h2>
            <p class="editorial-lead-light">
              “Today's woman is no longer confined to household boundaries. She is making her mark in entertainment,
              politics, industry, business, education, medicine, technology, and beyond.”
            </p>
            <p class="editorial-paragraph-light">
              <strong>Accolade Screenlady</strong> is a women-centric Marathi magazine that aims to present the many
              dimensions of women's personalities and lives to its readers. Going beyond the glamorous public image of
              actresses, models and artists from the entertainment industry, the magazine seeks to explore their
              emotions, struggles, experiences, thoughts and the ups and downs of their personal and professional
              journeys.
            </p>
            <p class="editorial-paragraph-light">
              Through exclusive interviews with renowned actresses from the film industry, readers get insights into
              their fashion trends, beauty, acting careers and lesser-known aspects of their lives. However, the scope
              of Accolade Screenlady extends far beyond the entertainment world. The magazine also gives paramount
              importance to the inspiring journeys of women leaders in politics, successful doctors, engineers, pilots,
              administrative officers, women entrepreneurs, business professionals and senior executives in the
              corporate sector.
            </p>

            <div class="editorial-feature-pills">
              <div class="feature-pill-light">📖 Premium High-Gloss Print Edition</div>
              <div class="feature-pill-light">👑 Cinema, Culture & Performing Arts</div>
              <div class="feature-pill-light">💼 Corporate Leadership & Entrepreneurs</div>
              <div class="feature-pill-light">🏛️ Administrative & Political Pioneers</div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 2: Visionary Concept Creator & Founder (Dark Luxury) -->
    <section class="editorial-visionary-section" id="founder">
      <div class="container">
        <div class="visionary-grid">

          <div class="visionary-photo-col">
            <div class="visionary-frame" data-lightbox-src="/assets/images/team/prashant-sagvekar.jpeg"
              data-lightbox-title="Mr. Prashant Chandrakant Sagvekar - Founder & Publisher"
              data-lightbox-theme="Founder Spotlight">
              <img src="/assets/images/team/prashant-sagvekar.jpeg" alt="Mr. Prashant Chandrakant Sagvekar"
                class="visionary-img" style="object-position: top center;">
            </div>
            <div class="visionary-portrait-inset" title="Mr. Prashant Chandrakant Sagvekar">
              <img src="/assets/images/prashant-sagvekar-main.jpg" alt="Mr. Prashant Chandrakant Sagvekar Portrait">
            </div>
          </div>

          <div class="visionary-content-col">
            <span class="editorial-kicker">✦ Founder, Publisher & Editor</span>
            <h2 class="visionary-name">A Vision Inspired by Years of Journalistic Experience</h2>
            <div class="visionary-roles">Mr. Prashant Chandrakant Sagvekar • Senior Broadcast Journalist &
              Conceptualizer</div>

            <p class="visionary-bio" style="font-size: 1.05rem; color: #EDE8DE; margin-top: 1.25rem;">
              The conceptualizer, publisher and editor of Accolade Screenlady, <strong>Mr. Prashant Chandrakant
                Sagvekar</strong>, is a senior journalist with more than 25 years of distinguished experience in the
              media industry.
            </p>

            <p class="visionary-bio">
              His professional experience with reputed media organisations such as <strong>All India Radio, Doordarshan
                Sahyadri, Sahara Samay</strong> and <strong>Saam Marathi</strong> has played an instrumental role in
              shaping the vision behind this magazine.
            </p>

            <p class="visionary-bio">
              Accolade Screenlady was conceptualised with the objective of creating an independent platform where the
              achievements of women from different walks of life could receive national recognition and their inspiring
              stories could reach a wider audience.
            </p>

            <div style="margin-top: 2rem;">
              <a href="#team" class="btn-editorial-gold">
                <span>View Full Editorial Board</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 3: Executive Leadership & Editorial Board (Light Ivory) -->
    <section class="editorial-about-section" id="team" style="background: #FFFFFF;">
      <div class="container">

        <div class="editorial-team-header" style="margin-bottom: 3.5rem;">
          <span class="editorial-kicker-light">✦ The Leadership Behind The Vision</span>
          <h2 class="editorial-team-heading">Our Executive Leadership & Editorial Board</h2>
          <p class="editorial-team-sub">
            Meet the visionary journalists, acclaimed performing artists, and media directors guiding <em>Accolade
              Screenlady</em>.
          </p>
        </div>

        <div class="editorial-team-grid">

          <!-- 1. Mr. Prashant Sagvekar -->
          <div class="team-member-card">
            <div class="team-photo-wrap" data-lightbox-src="/assets/images/team/prashant-sagvekar.jpeg"
              data-lightbox-title="Mr. Prashant Sagvekar - Founder & Publisher"
              data-lightbox-theme="Executive Leadership">
              <img src="/assets/images/team/prashant-sagvekar.jpeg" alt="Mr. Prashant Sagvekar" class="team-photo-img"
                style="object-position: top center;">
              <span class="team-role-badge">Founder & Publisher</span>
            </div>
            <div class="team-details">
              <h3 class="team-name">Mr. Prashant Sagvekar</h3>
              <span class="team-designation">Founder & Publisher</span>
              <p class="team-bio">
                Senior journalist with 25+ years of distinguished media leadership with All India Radio, Doordarshan
                Sahyadri, Sahara Samay, and Saam Marathi. Concept creator and visionary publisher dedicated to
                spotlighting women's resilience and triumph.
              </p>
            </div>
          </div>

          <!-- 2. Mrs. Amruta Rao -->
          <div class="team-member-card">
            <div class="team-photo-wrap" data-lightbox-src="/assets/images/team/amruta-rao.jpeg"
              data-lightbox-title="Mrs. Amruta Rao - Editor In Chief" data-lightbox-theme="Editorial Board">
              <img src="/assets/images/team/amruta-rao.jpeg" alt="Mrs. Amruta Rao" class="team-photo-img"
                style="object-position: top center;">
              <span class="team-role-badge">Editor In Chief</span>
            </div>
            <div class="team-details">
              <h3 class="team-name">Mrs. Amruta Rao</h3>
              <span class="team-designation">Editor In Chief</span>
              <p class="team-bio">
                Directs the magazine's editorial curation, investigative depth, and high-fashion aesthetic. She
                orchestrates cover features, cultural interviews, and thought-provoking discourses on women shaping
                entertainment, society, and modern enterprise.
              </p>
            </div>
          </div>

          <!-- 3. Mrs. Manasi Ingle -->
          <div class="team-member-card">
            <div class="team-photo-wrap" data-lightbox-src="/assets/images/team/mansi-ingle.jpeg"
              data-lightbox-title="Mrs. Manasi Ingle - Board Member" data-lightbox-theme="Board of Directors">
              <img src="/assets/images/team/mansi-ingle.jpeg" alt="Mrs. Manasi Ingle" class="team-photo-img"
                style="object-position: center 20%;">
              <span class="team-role-badge">Board Member</span>
            </div>
            <div class="team-details">
              <h3 class="team-name">Mrs. Manasi Ingle</h3>
              <span class="team-designation">Board Member</span>
              <p class="team-bio">
                Provides strategic stewardship and organizational leadership. Passionate about women empowerment,
                education, and grassroots leadership, she steers initiatives that champion unsung heroines and emerging
                changemakers across Maharashtra.
              </p>
            </div>
          </div>

          <!-- 4. Mrs. Supriya Vinod -->
          <div class="team-member-card">
            <div class="team-photo-wrap" data-lightbox-src="/assets/images/team/supriya-vinod.jpeg"
              data-lightbox-title="Mrs. Supriya Vinod - Board Member" data-lightbox-theme="Board of Directors">
              <img src="/assets/images/team/supriya-vinod.jpeg" alt="Mrs. Supriya Vinod" class="team-photo-img"
                style="object-position: top center;">
              <span class="team-role-badge">Board Member</span>
            </div>
            <div class="team-details">
              <h3 class="team-name">Mrs. Supriya Vinod</h3>
              <span class="team-designation">Board Member</span>
              <p class="team-bio">
                Acclaimed veteran actress and distinguished cultural icon. Infuses profound artistic heritage and
                creative mentorship into the publication, celebrating cinematic excellence and performing arts across
                Marathi and Indian entertainment.
              </p>
            </div>
          </div>

          <!-- 5. Mrs. Sakshi Sagvekar -->
          <div class="team-member-card">
            <div class="team-photo-wrap" data-lightbox-src="/assets/images/team/sakshi-sagvekar.jpeg"
              data-lightbox-title="Mrs. Sakshi Sagvekar - Managing Director" data-lightbox-theme="Executive Leadership">
              <img src="/assets/images/team/sakshi-sagvekar.jpeg" alt="Mrs. Sakshi Sagvekar" class="team-photo-img"
                style="object-position: center 12%;">
              <span class="team-role-badge">Managing Director</span>
            </div>
            <div class="team-details">
              <h3 class="team-name">Mrs. Sakshi Sagvekar</h3>
              <span class="team-designation">Managing Director</span>
              <p class="team-bio">
                Directs executive operations, business administration, and print production workflows. Dedicated to
                operational excellence, brand governance, and strategic growth across digital channels and collector's
                print publications.
              </p>
            </div>
          </div>

          <!-- 6. Mr. Vedang Sagvekar -->
          <div class="team-member-card">
            <div class="team-photo-wrap" data-lightbox-src="/assets/images/team/vedang-sagvekar.jpeg"
              data-lightbox-title="Mr. Vedang Sagvekar - Marketing Director" data-lightbox-theme="Executive Leadership">
              <img src="/assets/images/team/vedang-sagvekar.jpeg" alt="Mr. Vedang Sagvekar" class="team-photo-img"
                style="object-position: center 15%;">
              <span class="team-role-badge">Marketing Director</span>
            </div>
            <div class="team-details">
              <h3 class="team-name">Mr. Vedang Sagvekar</h3>
              <span class="team-designation">Marketing Director</span>
              <p class="team-bio">
                Spearheads brand outreach, corporate sponsorships, and multi-channel marketing campaigns. He expands
                Screenlady's cross-platform readership, strategic partnerships, and contemporary digital engagement
                nationwide.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Section 4: Philosophy Banner (Dark Gold Foil) -->
    <section class="editorial-philosophy-banner" id="philosophy">
      <div class="container philosophy-container">

        <img src="/assets/images/logo-2.png" alt="Accolade Queen Crest" class="philosophy-crest">

        <div
          style="font-family: var(--font-editorial-body); font-size: 0.85rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-light-accent); margin-bottom: 1rem;">
          ✦ ACCOLADE SCREENLADY – A MIRROR OF THE WORLD OF WOMEN! ✦
        </div>

        <h2 class="philosophy-tagline-primary" style="font-size: clamp(2rem, 3.8vw, 3.2rem); margin-bottom: 1.5rem;">
          Celebrating Women's Success, Inspiring the Next Generation!
        </h2>

        <div
          style="max-width: 840px; margin: 0 auto 2.5rem; color: #D8D3C8; font-family: var(--font-editorial-body); font-size: 1.02rem; line-height: 1.8;">
          <p style="margin-bottom: 1rem;">
            Today, women have more opportunities than ever to demonstrate their abilities and establish themselves in
            different fields. However, platforms that recognise their achievements and bring their experiences and
            stories to society are equally important. Accolade Screenlady is committed to contributing to this vision.
          </p>
          <p>
            Driven by the philosophy <strong>“Her Beauty, Her Achievements, Her Story of Struggle!”</strong>, Accolade
            Screenlady is much more than just a publication. It is an inspiring platform that celebrates women's
            confidence, dreams, determination and success.
          </p>
        </div>

        <div
          style="padding: 1.5rem 2rem; border-top: 1px solid rgba(212, 175, 55, 0.3); border-bottom: 1px solid rgba(212, 175, 55, 0.3); margin-bottom: 2.5rem; background: rgba(212, 175, 55, 0.05); border-radius: 8px;">
          <div
            style="font-family: var(--font-editorial-heading); font-size: clamp(1.4rem, 2.5vw, 2.2rem); font-weight: 800; color: #FFFFFF; margin-bottom: 0.65rem;">
            “Her Beauty, Her Achievements, Her Story of Struggle!”
          </div>
          <div
            style="font-family: var(--font-editorial-heading); font-size: clamp(1.1rem, 1.8vw, 1.5rem); font-style: italic; color: var(--gold-light-accent);">
            “Because every woman has a story to tell... and every story deserves to reach the world!”
          </div>
        </div>

        <div class="philosophy-actions">
          <button type="button" class="btn-editorial-gold" onclick="handleAvailableInPrintClick()">
            <span>Order Collector's Print Edition</span>
            <span>→</span>
          </button>
          <a href="#contact" class="btn-editorial-outline">
            <span>Contact Editorial Desk</span>
          </a>
        </div>

      </div>
    </section>

        <!-- ==============================================
         SECTION 5: OFFICIAL MAGAZINE INTRODUCTION & COMPENDIUM
         (Replaced Official Contact & Editorial Desk)
    ============================================== -->
    <section class="magazine-official-info-section" id="contact">
      <div class="container">

        <!-- Header -->
        <div class="editorial-header-center" style="margin-bottom: 3.5rem;">
          <span class="editorial-kicker">✦ OFFICIAL COMPENDIUM & MAGAZINE INTRODUCTION</span>
          <h2 class="editorial-section-title-dark" style="font-size: clamp(2rem, 3.4vw, 3rem); margin-bottom: 0.65rem;">
            ACCOLADE SCREENLADY MAGAZINE
          </h2>
          <p class="editorial-section-sub-dark" style="font-size: 1.15rem; color: var(--gold-light-accent); font-weight: 600; max-width: 820px; margin: 0 auto;">
            A Magazine That Celebrates Women's Achievements, Struggles and Success Stories
          </p>
          <p class="editorial-section-sub-dark" style="font-size: 0.95rem; opacity: 0.85; max-width: 760px; margin: 0.5rem auto 0;">
            A premier women-centric publication exploring the diverse world of women — from entertainment to entrepreneurship, from glamour to great milestones.
          </p>
        </div>

        <!-- 1. English Introduction Showcase Card -->
        <div class="magazine-intro-card">
          <span class="mag-title-badge">✦ EDITORIAL VISION & MISSION</span>
          <h3 class="mag-main-headline">
            Celebrating Women's Achievements, Experiences and Inspiring Journeys
          </h3>
          <div class="mag-lead-quote">
            “Accolade Screenlady is dedicated to celebrating the achievements, experiences, and inspiring journeys of women across all walks of life.”
          </div>
          <p class="mag-body-paragraph">
            <strong>Accolade Screenlady</strong> is a women-centric Marathi magazine dedicated to highlighting the achievements, experiences and inspiring journeys of women across various fields, including entertainment, glamour, women empowerment, business, entrepreneurship and social development.
          </p>
          <p class="mag-body-paragraph" style="margin-bottom: 0;">
            The magazine aims not only to feature well-known personalities but also to bring forward the inspiring stories of ordinary women who have achieved extraordinary success through hard work, determination and perseverance.
          </p>
        </div>

        <!-- 2. Key Features of the Magazine -->
        <div style="margin-bottom: 4.5rem;">
          <div style="text-align: center; margin-bottom: 2.8rem;">
            <span class="editorial-kicker">✦ DIVERSE EDITORIAL DOMAINS</span>
            <h3 style="font-family: var(--font-editorial-heading); font-size: clamp(1.6rem, 2.6vw, 2.2rem); color: #FFFFFF; margin-top: 0.5rem;">
              Key Features of the Magazine
            </h3>
          </div>

          <div class="mag-features-grid">
            
            <!-- Feature 1: Entertainment World -->
            <div class="mag-feature-item">
              <div class="mag-feature-bg" style="background-image: url('assets/images/magazine-photos/3.1.jpg');"></div>
              <div class="mag-feature-overlay"></div>
              <div class="mag-feature-content">
                <div class="mag-feature-top">
                  <div class="mag-feature-icon">🎬</div>
                  <span class="mag-feature-tag">Cinema & Arts</span>
                </div>
                <h4>Entertainment World</h4>
                <p>Exclusive insights into the lives and journeys of actresses, models, artists and entertainment personalities from the Marathi and Hindi film industries.</p>
              </div>
            </div>

            <!-- Feature 2: Women's Achievements -->
            <div class="mag-feature-item">
              <div class="mag-feature-bg" style="background-image: url('assets/images/magazine-photos/4.2.jpg');"></div>
              <div class="mag-feature-overlay"></div>
              <div class="mag-feature-content">
                <div class="mag-feature-top">
                  <div class="mag-feature-icon">👑</div>
                  <span class="mag-feature-tag">Leadership</span>
                </div>
                <h4>Women's Achievements</h4>
                <p>Success stories of women making impactful marks in politics, medicine, engineering, aviation, education and public administration.</p>
              </div>
            </div>

            <!-- Feature 3: Women Entrepreneurs -->
            <div class="mag-feature-item">
              <div class="mag-feature-bg" style="background-image: url('assets/images/magazine-photos/3.4.jpg');"></div>
              <div class="mag-feature-overlay"></div>
              <div class="mag-feature-content">
                <div class="mag-feature-top">
                  <div class="mag-feature-icon">💼</div>
                  <span class="mag-feature-tag">Enterprise</span>
                </div>
                <h4>Women Entrepreneurs</h4>
                <p>Inspiring journeys of women establishing their distinct identities in industries, businesses, corporate sectors, real estate and startups.</p>
              </div>
            </div>

            <!-- Feature 4: Fashion & Lifestyle -->
            <div class="mag-feature-item">
              <div class="mag-feature-bg" style="background-image: url('assets/images/magazine-photos/5.1.jpg');"></div>
              <div class="mag-feature-overlay"></div>
              <div class="mag-feature-content">
                <div class="mag-feature-top">
                  <div class="mag-feature-icon">✨</div>
                  <span class="mag-feature-tag">Haute Couture</span>
                </div>
                <h4>Fashion & Lifestyle</h4>
                <p>Beauty, haute fashion, jewellery, personality development, brand introductions and evolving contemporary lifestyle trends.</p>
              </div>
            </div>

            <!-- Feature 5: Inspirational Interviews -->
            <div class="mag-feature-item">
              <div class="mag-feature-bg" style="background-image: url('assets/images/magazine-photos/4.1.jpg');"></div>
              <div class="mag-feature-overlay"></div>
              <div class="mag-feature-content">
                <div class="mag-feature-top">
                  <div class="mag-feature-icon">🎙️</div>
                  <span class="mag-feature-tag">Memoirs</span>
                </div>
                <h4>Inspirational Interviews</h4>
                <p>Exclusive in-depth interviews and personal memoirs of women who have overcome adversity, persevered, and achieved lasting success.</p>
              </div>
            </div>

            <!-- Feature 6: Stories & Literature -->
            <div class="mag-feature-item">
              <div class="mag-feature-bg" style="background-image: url('assets/images/magazine-photos/4.3.jpg');"></div>
              <div class="mag-feature-overlay"></div>
              <div class="mag-feature-content">
                <div class="mag-feature-top">
                  <div class="mag-feature-icon">📖</div>
                  <span class="mag-feature-tag">Literature</span>
                </div>
                <h4>Stories & Literature</h4>
                <p>Romantic stories, suspense and mystery narratives, social issues, and thought-provoking analytical essays on modern womanhood.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- 3. Official Magazine Information & PRGI Registry -->
        <div class="official-reg-container" id="official-info">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
              <span class="editorial-kicker">✦ GOVERNMENT OF INDIA PRGI REGISTRY</span>
              <h3 style="font-family: var(--font-editorial-heading); font-size: clamp(1.5rem, 2.4vw, 2rem); color: #FFFFFF; margin-top: 0.5rem; margin-bottom: 0.25rem;">
                Official Magazine Information
              </h3>
            </div>
            <div class="official-seal-note">
              <span>🏛️ PRGI Registered • MHMAR/26/A3113</span>
            </div>
          </div>

          <div class="official-table-wrapper">
            <table class="official-reg-table">
              <thead>
                <tr>
                  <th>Particulars</th>
                  <th>Details</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Magazine Name</td>
                  <td><strong>Accolade Screenlady</strong></td>
                </tr>
                <tr>
                  <td>Language</td>
                  <td>Marathi</td>
                </tr>
                <tr>
                  <td>Publication Format</td>
                  <td>Monthly Magazine (Print & Digital Editions)</td>
                </tr>
                <tr>
                  <td>Publisher</td>
                  <td>Mr. Prashant Chandrakant Sagvekar</td>
                </tr>
                <tr>
                  <td>Editor</td>
                  <td>Mr. Prashant Chandrakant Sagvekar</td>
                </tr>
                <tr>
                  <td>Publishing District</td>
                  <td>Raigad, Maharashtra, India</td>
                </tr>
                <tr>
                  <td>Registration Number</td>
                  <td><span style="color: var(--gold-light-accent); font-weight: 800; font-family: monospace; font-size: 1.05rem;">MHMAR/26/A3113</span></td>
                </tr>
                <tr>
                  <td>Registration Date</td>
                  <td>6 May 2026</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="official-seal-note" style="background: rgba(212, 175, 55, 0.08); border-color: rgba(212, 175, 55, 0.35); color: #EDE8DE;">
            <span>ℹ️ <strong>Official Certification:</strong> The magazine is officially registered with the <em>Office of the Press Registrar General of India (PRGI)</em>.</span>
          </div>
        </div>

        <!-- 4. Target Readers and Advertising Opportunities -->
        <div class="advertising-opp-container" id="advertising-info">
          
          <div>
            <span class="editorial-kicker">✦ TARGET AUDIENCE</span>
            <h4 style="font-family: var(--font-editorial-heading); font-size: 1.45rem; color: #FFFFFF; margin-top: 0.6rem; margin-bottom: 0.5rem;">
              Target Readers & Industry Sectors
            </h4>
            <p style="font-family: var(--font-editorial-body); font-size: 0.92rem; color: #BBB6AD; line-height: 1.6;">
              The magazine aims to connect with ambitious readers and forward-thinking enterprises across key sectors:
            </p>
            <div class="adv-sectors-list">
              <div class="adv-list-item">Banking and Financial Institutions</div>
              <div class="adv-list-item">Real Estate and Construction Companies</div>
              <div class="adv-list-item">Stock Market and Investment Firms</div>
