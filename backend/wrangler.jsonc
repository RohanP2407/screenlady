{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenlady-backend",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "screenlady-db",
      "database_id": "ec42c51c-0f1f-42cc-b425-9352a1abd190"
    }
  ],
  "vars": {
    "FRONTEND_URL": "http://localhost:4321",
    "ENVIRONMENT": "production",
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/acooladescreenlady",
    "IMAGEKIT_PUBLIC_KEY": "public_HK3u+qaYDRJ9IUqH0FoURIpxLrQ="
  }
}