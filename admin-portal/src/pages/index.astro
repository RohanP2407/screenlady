                  <input type="text" id="cfgMagPopupBadge" class="post-input-field" value="Screenlady Print Magazine">
                </div>

                <div>
                  <label class="post-input-label" for="cfgMagPopupMsg">Announcement Message Text</label>
                  <input type="text" id="cfgMagPopupMsg" class="post-input-field" value="Collector's Print Edition Now Available • Insured Doorstep Courier Across India">
                </div>
              </div>

              <div style="display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--admin-border); padding-top: 1.5rem; margin-top: 1.5rem;">
                <button type="submit" class="admin-btn admin-btn-gold" style="font-weight: 700; padding: 0.75rem 2rem;">
                  Save Magazine Settings &rarr;
                </button>
              </div>
            </form>
          </div>
