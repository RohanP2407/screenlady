                  <label class="post-input-label" for="cfgMagPage2">Page 2: Inside Feature Spread Image URL / ImageKit CDN Path *</label>
                  <input type="text" id="cfgMagPage2" class="post-input-field" value="https://ik.imagekit.io/acooladescreenlady/assets/images/magazine-page2-feature.jpg" required oninput="const img = document.getElementById('adminPanelMagPage2Img'); if(img) img.src=this.value;">
